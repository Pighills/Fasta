{
  "enabledPlugins": {
    "carta-investors@knowledge-work-plugins": false,
    "carta-cap-table@knowledge-work-plugins": false,
    "carta-crm@knowledge-work-plugins": false,
    "lseg@knowledge-work-plugins": false,
    "daloopa@knowledge-work-plugins": false,
    "bigdata-com@knowledge-work-plugins": false,
    "chronograph-gp@knowledge-work-plugins": false,
    "blackrock-advisor-center-plugin@knowledge-work-plugins": false,
    "claude-for-financial-advisors@knowledge-work-plugins": false,
    "ponytail@ponytail": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true
  },
  "permissions": {
    "allow": [
      "Bash(curl -s -I:*)",
      "Bash(curl -sI:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "Bash(git:*)",
      "Bash(node:*)",
      "Bash(npx serve:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(echo:*)",
      "Bash(pwd)",
      "Bash(cd:*)",
      "Bash(sed -n:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(curl -s:*)",
      "Bash(npx playwright:*)",
      "Bash(npx --no-install:*)",
      "Bash(gh api:*)",
      "Bash(gh repo view:*)",
      "Bash(codex execpolicy check:*)"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git branch -D main:*)"
    ]
  }
}
